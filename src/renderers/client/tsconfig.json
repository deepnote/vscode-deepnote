{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": ["ES2020", "DOM"],
        "jsx": "react",
        "declaration": false,
        "strict": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "../../../dist/renderers/client",
        "baseUrl": ".",
        "typeRoots": ["./types", "../../../node_modules/@types"]
    },
    "include": ["./**/*.ts", "./**/*.tsx"],
    "exclude": ["node_modules"]
}

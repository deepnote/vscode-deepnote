version: '1.0.0'
metadata:
  createdAt: '2025-01-01T00:00:00.000Z'
  modifiedAt: '2025-01-01T00:00:00.000Z'
project:
  id: e2e-chart-uuid-project
  name: E2E Chart UUID
  notebooks:
    - id: e2e-chart-uuid-notebook
      name: Chart UUID
      blocks:
        - id: e2e-chart-data-block
          blockGroup: e2e-chart-data-group
          type: code
          content: |-
            import importlib.util
            import sys
            import uuid

            import pandas as pd


            def _origin(name):
                try:
                    spec = importlib.util.find_spec(name)
                except Exception as exc:
                    return f"error:{exc}"
                return spec.origin if spec else None


            print("DIAG", sys.executable, "|nw:", _origin("narwhals"), "|sd:", _origin("stack_data"))
            print("DIAG path:", ":".join(sys.path))

            chart_df = pd.DataFrame(
                {
                    "trace_id": [uuid.UUID(int=index) for index in range(3)],
                    "amount": [10, 20, 30],
                }
            )
            print("chart data ready")
          sortingKey: a0
          metadata: {}
        - id: e2e-chart-viz-block
          blockGroup: e2e-chart-viz-group
          type: visualization
          content: ''
          sortingKey: a1
          metadata:
            deepnote_variable_name: chart_df
            deepnote_visualization_spec:
              mark: bar
              encoding:
                x:
                  field: trace_id
                  type: nominal
                y:
                  field: amount
                  type: quantitative
            deepnote_chart_filter:
              advancedFilters: []
      executionMode: block
      isModule: false
  settings: {}
